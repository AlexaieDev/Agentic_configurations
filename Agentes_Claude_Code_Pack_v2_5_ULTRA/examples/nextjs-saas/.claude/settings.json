{
  "$schema": "https://claude.ai/settings-schema.json",
  "version": "1.0",

  "project": {
    "name": "NextJS SaaS Application",
    "type": "web",
    "framework": "nextjs",
    "language": "typescript"
  },

  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server"],
      "env": {
        "SUPABASE_URL": "${SUPABASE_URL}",
        "SUPABASE_SERVICE_ROLE_KEY": "${SUPABASE_SERVICE_ROLE_KEY}"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "${SENTRY_ORG}",
        "SENTRY_PROJECT": "nextjs-saas"
      }
    }
  },

  "hooks": {
    "SessionStart": [
      {
        "command": "./hooks/session-start/load-context.sh",
        "timeout": 5000
      }
    ],
    "PreCommit": [
      {
        "command": "npm run lint && npm run typecheck",
        "timeout": 60000,
        "blocking": true
      },
      {
        "command": "./hooks/pre-commit/security-scan.sh",
        "timeout": 30000,
        "blocking": true
      }
    ],
    "PrePush": [
      {
        "command": "npm run test",
        "timeout": 120000,
        "blocking": true
      }
    ]
  },

  "commands": {
    "enabled": true,
    "directory": "./commands"
  },

  "agents": {
    "default": ["Next.js Agent", "React Agent"],
    "security": ["Security Agent", "Authentication Agent"],
    "database": ["Database Architect Agent"],
    "performance": ["Frontend Performance Agent"]
  },

  "permissions": {
    "allowedPaths": [
      "src/**",
      "public/**",
      "supabase/**",
      "tests/**"
    ],
    "deniedPaths": [
      ".env*",
      "*.pem",
      "*.key"
    ],
    "allowedCommands": [
      "npm",
      "npx",
      "git",
      "supabase"
    ]
  },

  "codeStyle": {
    "formatter": "prettier",
    "linter": "eslint",
    "importOrder": [
      "react",
      "next",
      "@/components",
      "@/lib",
      "@/hooks",
      "@/types"
    ]
  },

  "testing": {
    "framework": "jest",
    "e2e": "playwright",
    "coverageThreshold": 80
  }
}
